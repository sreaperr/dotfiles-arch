[
{
	/*==========================
	    BARRA PRINCIPAL
	==========================*/

	"include": [
		"~/.config/waybar/modules/*.jsonc",
		"~/.config/waybar/modules/custom/*.jsonc",
		"~/.config/waybar/modules/hyprland/*.jsonc"
	],

	"modules-left": [
		"custom/distro",
		"clock#time",
		"clock#date"
	],
	"modules-center": [
		"hyprland/workspaces"
	],
	"modules-right": [
		"network",
		"pulseaudio#output",
		"bluetooth",
		"memory",
		"cpu",
		"custom/notifications"
	],

	"layer": "top",
	"height": 0,
	"width": 0,
	"margin-top": 8,
	"margin-left": 8,
	"margin-right": 8,
	"margin-bottom": 0,
	"spacing": 0,
	"mode": "dock",
	"reload_style_on_change": true
}
]
