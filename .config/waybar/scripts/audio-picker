#!/usr/bin/env bash
#
# Pick default PulseAudio/PipeWire output sink via rofi
#

ROFI_WIDTH=260

# Get all sinks: "index name description"
get_sinks() {
	pactl list sinks | awk '
		/^Sink #/        { idx = substr($2, 2) }
		/^\tName:/        { name = $2 }
		/^\tDescription:/ { sub(/^\tDescription: /, ""); desc = $0; print idx "\t" name "\t" desc }
	'
}

default_sink() {
	pactl get-default-sink
}

# Position rofi just below the click point, centered horizontally on cursor
rofi_position() {
	local pos
	pos=$(hyprctl cursorpos 2>/dev/null)
	local cx cy
	cx=$(echo "$pos" | awk -F',' '{print int($1)}')
	cy=$(echo "$pos" | awk -F',' '{print int($2)}')

	local x=$(( cx - ROFI_WIDTH / 2 ))
	local y=$(( cy + 5 ))

	echo "-theme-str 'window { x-offset: ${x}px; y-offset: ${y}px; }'"
}

main() {
	local sinks
	sinks=$(get_sinks)

	local current
	current=$(default_sink)

	local labels=()
	local names=()
	while IFS=$'\t' read -r _ name desc; do
		if [[ "$name" == "$current" ]]; then
			labels+=(" $desc")
		else
			labels+=("  $desc")
		fi
		names+=("$name")
	done <<< "$sinks"

	local pos_args
	pos_args=$(rofi_position)

	local chosen
	chosen=$(printf '%s\n' "${labels[@]}" | eval rofi -dmenu \
		-theme ~/.config/rofi/dropdown.rasi \
		"$pos_args" \
		-p "󰕾  Salida" \
		-no-custom \
		-i)

	[[ -z "$chosen" ]] && exit 0

	local i
	for i in "${!labels[@]}"; do
		if [[ "${labels[$i]}" == "$chosen" ]]; then
			local sink="${names[$i]}"
			pactl set-default-sink "$sink"
			pactl list short sink-inputs | awk '{print $1}' | \
				xargs -I{} pactl move-sink-input {} "$sink"
			notify-send "Audio" "Salida: $(echo "$chosen" | sed 's/^[[:space:]]*//')" \
				-i audio-volume-high \
				-h string:x-canonical-private-synchronous:audio-picker
			break
		fi
	done
}

main "$@"
