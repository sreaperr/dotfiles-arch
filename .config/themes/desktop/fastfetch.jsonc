{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/sreaper.png",
        "type": "kitty-direct",
        "width": 46,
        "height": 18,
        "padding": {
            "top": 0,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;192;202;245",
            "title": "38;2;122;162;247"
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[38;2;122;162;247m┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\u001b[0m"
        },
        "break",
        {
            "type": "os",
            "key": "   OS      ",
            "keyColor": "38;2;187;154;247"
        },
        {
            "type": "kernel",
            "key": "   KERNEL  ",
            "keyColor": "38;2;125;207;255"
        },
        {
            "type": "packages",
            "key": "   PKGS    ",
            "keyColor": "38;2;158;206;106"
        },
        {
            "type": "wm",
            "key": "   WM      ",
            "keyColor": "38;2;122;162;247"
        },
        {
            "type": "terminal",
            "key": "   TERM    ",
            "keyColor": "38;2;224;175;104"
        },
        {
            "type": "shell",
            "key": "   SHELL   ",
            "keyColor": "38;2;255;158;100"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;122;162;247m┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\u001b[0m"
        },
        "break",
        {
            "type": "host",
            "key": "   HOST    ",
            "keyColor": "38;2;125;207;255"
        },
        {
            "type": "cpu",
            "key": "   CPU     ",
            "keyColor": "38;2;247;118;142"
        },
        {
            "type": "gpu",
            "key": "   GPU     ",
            "keyColor": "38;2;187;154;247"
        },
        {
            "type": "memory",
            "key": "   RAM     ",
            "keyColor": "38;2;158;206;106"
        },
        {
            "type": "disk",
            "key": "   DISK    ",
            "keyColor": "38;2;224;175;104",
            "folders": "/"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;122;162;247m┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\u001b[0m"
