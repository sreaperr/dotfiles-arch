# ======================================
# KANSHI — PERFIL POR DEFECTO
# Pensado para uso en máquina virtual:
# un único perfil "auto" que se aplica
# siempre, sea cual sea la salida detectada.
# ======================================
#
# Para ver los nombres exactos de tus salidas ejecuta:
#   hyprctl monitors
# ======================================

profile auto {
    output * mode preferred position 0,0 scale 1
}
